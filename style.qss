* {
    font-family: "Segoe UI Variable", "Segoe UI", "Vazirmatn", sans-serif;
    color: #e5e7eb;
}

QMainWindow, QWidget#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a0b1e, stop:0.5 #12132b, stop:1 #1a1b3a);
}

/* ---------- App header ---------- */
QLabel[class="appTitle"] {
    font-size: 22px;
    font-weight: 700;
    color: #f1f5f9;
}
QLabel[class="appSubtitle"] {
    font-size: 12px;
    color: #94a3b8;
}

/* ---------- Cards ---------- */
QFrame#card {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
}

/* ---------- Status card ---------- */
QFrame#statusCard {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}
QFrame#statusCard[state="blocked"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(239,68,68,0.18), stop:1 rgba(220,38,38,0.05));
    border: 1px solid rgba(239,68,68,0.4);
}
QFrame#statusCard[state="protected"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(16,185,129,0.18), stop:1 rgba(5,150,105,0.05));
    border: 1px solid rgba(16,185,129,0.4);
}
QFrame#statusCard[state="checking"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(245,158,11,0.15), stop:1 rgba(180,83,9,0.05));
    border: 1px solid rgba(245,158,11,0.35);
}

QLabel[class="statusIcon"] {
    font-size: 42px;
    font-weight: 700;
    min-width: 90px; min-height: 90px;
    max-width: 90px; max-height: 90px;
    border-radius: 45px;
}
QFrame#statusCard[state="blocked"]   QLabel[class="statusIcon"] {
    color: #ef4444; background-color: rgba(239,68,68,0.18);
}
QFrame#statusCard[state="protected"] QLabel[class="statusIcon"] {
    color: #10b981; background-color: rgba(16,185,129,0.18);
}
QFrame#statusCard[state="checking"]  QLabel[class="statusIcon"] {
    color: #f59e0b; background-color: rgba(245,158,11,0.18);
}

QLabel[class="statusTitle"] {
    font-size: 20px;
    font-weight: 700;
    color: #f8fafc;
}
QLabel[class="statusSubtitle"] {
    font-size: 13px;
    color: #cbd5e1;
}

/* ---------- Card titles ---------- */
QLabel[class="cardTitle"] {
    font-size: 14px;
    font-weight: 600;
    color: #f1f5f9;
}
QLabel[class="cardDesc"] {
    font-size: 12px;
    color: #94a3b8;
}

/* ---------- Stats ---------- */
QLabel[class="statLabel"] {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 1px;
}
QLabel[class="statValue"] {
    font-size: 16px;
    font-weight: 600;
    color: #f1f5f9;
    font-family: "Cascadia Code", "Consolas", monospace;
}

/* ---------- DNS server rows ---------- */
QLabel[class="srvName"] {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    color: #cbd5e1;
}
QLabel[class="srvStatus"] {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 10px;
}
QLabel[class="srvStatus"][state="ok"]   { color: #10b981; background: rgba(16,185,129,0.12); }
QLabel[class="srvStatus"][state="fail"] { color: #ef4444; background: rgba(239,68,68,0.12); }
QLabel[class="srvStatus"][state="unknown"] { color: #94a3b8; background: rgba(148,163,184,0.1); }

QLabel[class="dot"] {
    color: #10b981;
    font-size: 9px;
}

/* ---------- Log ---------- */
QTextEdit#logView {
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    color: #cbd5e1;
    selection-background-color: rgba(99,102,241,0.4);
}

/* ---------- Scrollbar ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: rgba(148,163,184,0.3);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(148,163,184,0.5);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* ---------- Buttons ---------- */
QPushButton {
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    border: none;
}
QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #8b5cf6);
    color: #ffffff;
}
QPushButton[class="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:1 #7c3aed);
}
QPushButton[class="primary"]:pressed {
    background: #4338ca;
}

QPushButton[class="secondary"] {
    background: rgba(255, 255, 255, 0.06);
    color: #e5e7eb;
    border: 1px solid rgba(255, 255, 255, 0.1);
}
QPushButton[class="secondary"]:hover {
    background: rgba(255, 255, 255, 0.1);
}

QPushButton[class="ghost"] {
    background: transparent;
    color: #94a3b8;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton[class="ghost"]:hover { color: #e5e7eb; }

/* ---------- Scroll area ---------- */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- Theme Toggle Button ---------- */
QPushButton#themeToggle {
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#themeToggle:hover {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.26);
    color: #ffffff;
}
QPushButton#themeToggle:pressed {
    background: rgba(255, 255, 255, 0.05);
}